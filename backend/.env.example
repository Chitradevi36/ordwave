DATABASE_URL=postgresql://localhost/omnidist_development
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change_me_in_production
RAILS_ENV=development

# ── Razorpay Billing ───────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — set this to the value generated in Razorpay Dashboard
# Settings → Webhooks → Create/Edit webhook → "Secret"
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Razorpay Plan IDs for monthly subscriptions
# Create plans in Razorpay Dashboard → Products → Subscriptions → Plans
RAZORPAY_PLAN_ID_STARTER_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_xxxxxxxxxxxx

# App base URL (used in Razorpay success/cancel callback URLs)
APP_BASE_URL=http://localhost:3000
