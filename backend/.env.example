DATABASE_URL=postgresql://localhost/omnidist_development
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change_me_in_production
RAILS_ENV=development

# ── Razorpay Billing ───────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — set this to the value generated in Razorpay Dashboard
# Settings → Webhooks → Create/Edit webhook → "Secret"
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Razorpay Plan IDs for monthly subscriptions
# Create plans in Razorpay Dashboard → Products → Subscriptions → Plans
RAZORPAY_PLAN_ID_STARTER_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_xxxxxxxxxxxx

# App base URL (used in Razorpay success/cancel callback URLs)
APP_BASE_URL=http://localhost:3000
# ── Email Configuration ────────────────────────────────────────────────────
# SMTP settings for sending emails (invoices, dunning, notifications, etc)
MAILER_FROM_ADDRESS=chitra.rajaguru123@gmail.com
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_DOMAIN=ordwave.com

# ── SMS Configuration (Twilio) ─────────────────────────────────────────────
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Frontend URL ───────────────────────────────────────────────────────────
# Used for generating payment links in SMS notifications, emails, etc
FRONTEND_URL=http://localhost:3001

# ── OSRM Route Optimization ────────────────────────────────────────────────
# Open Source Routing Machine for optimizing delivery routes
# Docker: docker run -p 5000:5000 osrm/osrm-backend
OSRM_ENABLED=true
OSRM_ENDPOINT=http://localhost:5000
OSRM_SERVICE=routed
OSRM_PROFILE=car
OSRM_TIMEOUT=30
