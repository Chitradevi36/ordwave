<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <!-- Header -->
  <div style="background-color: #fee2e2; padding: 20px; border-bottom: 3px solid #ef4444; border-left: 5px solid #ef4444;">
    <h2 style="margin: 0; color: #991b1b;">
      ⚠️ Payment Unable to Process
    </h2>
    <p style="margin: 5px 0 0 0; color: #991b1b; font-size: 14px;">
      Invoice <%= @invoice.invoice_number %> — All Automatic Retries Exhausted
    </p>
  </div>

  <!-- Main Content -->
  <div style="padding: 30px;">
    <p style="color: #18181b;">Hi <%= @customer.name %>,</p>

    <p style="color: #dc2626; line-height: 1.6; margin: 20px 0;">
      <strong>We've been unable to process your payment for invoice <%= @invoice.invoice_number %> despite 3 automatic retry attempts.</strong>
    </p>

    <p style="color: #555; line-height: 1.6;">
      The payment failed due to: <strong><%= @failed_reason %></strong>
    </p>

    <!-- Invoice Details -->
    <div style="margin: 30px 0; border: 2px solid #ef4444; border-radius: 4px; padding: 20px; background-color: #fef2f2;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 14px;">
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Invoice Number</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.invoice_number %></p>
        </div>
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Outstanding Amount</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626;">₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></p>
        </div>
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Due Date</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.due_date.strftime('%b %d, %Y') %></p>
        </div>
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Retry Attempts</p>
          <p style="margin: 0; font-weight: 600;"><%= @payment.retry_count %> of 3</p>
        </div>
      </div>
    </div>

    <!-- What Happened -->
    <div style="margin: 30px 0; padding: 20px; background-color: #fef2f2; border-left: 4px solid #ef4444; border-radius: 4px;">
      <h3 style="margin: 0 0 10px 0; color: #991b1b; font-size: 14px;">
        ❌ Automatic Retries Complete
      </h3>
      <p style="color: #7f1d1d; font-size: 13px; margin: 0; line-height: 1.6;">
        We've attempted to process your payment 3 times over the past 4 days, but each attempt failed. 
        This typically indicates an issue with your payment method or bank.
      </p>
    </div>

    <!-- Solutions -->
    <div style="margin: 30px 0;">
      <h3 style="color: #18181b; margin: 0 0 15px 0; font-size: 14px;">How to Resolve This:</h3>
      <table width="100%" style="border-collapse: collapse;">
        <tr>
          <td style="padding: 12px; border: 1px solid #e5e7eb;">
            <strong style="color: #18181b;">1. Contact Your Bank</strong><br>
            <span style="color: #6b7280; font-size: 13px;">Ask your bank to confirm your card hasn't been blocked or flagged for fraud</span>
          </td>
        </tr>
        <tr>
          <td style="padding: 12px; border: 1px solid #e5e7eb; background-color: #f9fafb;">
            <strong style="color: #18181b;">2. Try a Different Card</strong><br>
            <span style="color: #6b7280; font-size: 13px;">
              Update your payment method to <a href="<%= payment_method_update_url(@payment) %>" style="color: #dc2626; text-decoration: none;">use a different card</a>
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding: 12px; border: 1px solid #e5e7eb;">
            <strong style="color: #18181b;">3. Request Manual Payment Link</strong><br>
            <span style="color: #6b7280; font-size: 13px;">
              Contact us to arrange <a href="<%= contact_support_url %>" style="color: #dc2626; text-decoration: none;">alternative payment options</a>
            </span>
          </td>
        </tr>
      </table>
    </div>

    <!-- CTA - Primary Action -->
    <div style="margin: 30px 0; text-align: center;">
      <a href="<%= payment_method_update_url(@payment) %>" style="display: inline-block; padding: 14px 40px; background-color: #dc2626; color: white; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 16px;">
        Update Payment Method
      </a>
      <p style="color: #6b7280; font-size: 12px; margin: 10px 0 0 0;">
        or <a href="<%= invoice_payment_url(@invoice) %>" style="color: #dc2626; text-decoration: none;">try another payment method</a>
      </p>
    </div>

    <!-- Urgent Notice -->
    <div style="margin: 30px 0; padding: 15px; background-color: #fef2f2; border-radius: 4px; border: 1px solid #fee2e2;">
      <p style="color: #7f1d1d; font-size: 12px; margin: 0;">
        <strong>⚠️ Important:</strong> This invoice is now overdue. Continued non-payment may result in 
        account restrictions or suspension. Please resolve this as soon as possible.
      </p>
    </div>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 30px 0;">

    <!-- Support -->
    <p style="color: #6b7280; font-size: 13px; line-height: 1.6;">
      <strong>Need immediate help?</strong><br>
      Our support team is available to assist with payment issues and arrange alternative payment methods.<br><br>
      <strong>Email:</strong> <%= ENV['MAILER_FROM_ADDRESS'] %><br>
      <strong>Response Time:</strong> We respond within 1 hour during business hours
    </p>
  </div>

  <!-- Footer -->
  <div style="background-color: #fef2f2; padding: 20px; text-align: center; border-top: 1px solid #fee2e2; font-size: 12px; color: #7f1d1d;">
    <p style="margin: 0;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
