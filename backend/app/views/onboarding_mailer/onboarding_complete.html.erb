<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  </head>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #111827; background: #f9fafb; margin: 0; padding: 0;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background: #f9fafb; padding: 40px 0;">
      <tr>
        <td align="center">
          <table width="480" cellpadding="0" cellspacing="0" style="background: #ffffff; border-radius: 8px; border: 1px solid #e5e7eb; padding: 40px;">
            <tr>
              <td>
                <!-- Logo / Brand -->
                <p style="margin: 0 0 24px; font-size: 16px; font-weight: 700; color: #059669;">
                  Orderlane
                </p>

                <!-- Emoji + Greeting -->
                <div style="margin: 0 0 24px;">
                  <p style="margin: 0 0 4px; font-size: 40px;">🚀</p>
                  <h2 style="margin: 0 0 8px; font-size: 24px; font-weight: 700; color: #111827;">
                    Welcome to Orderlane!
                  </h2>
                  <p style="margin: 0; font-size: 14px; color: #6b7280;">
                    <%= @organization.name %> is ready to go! 
                  </p>
                </div>

                <!-- Main Content -->
                <p style="margin: 0 0 20px; font-size: 15px; color: #374151; line-height: 1.6;">
                  Hi <%= @first_name %>,
                </p>

                <p style="margin: 0 0 20px; font-size: 15px; color: #374151; line-height: 1.6;">
                  Congratulations! Your <%= @organization.name %> distribution business setup is now complete. You're ready to start managing customers, products, orders, and payments from one unified platform.
                </p>

                <!-- Getting Started -->
                <div style="background: #f0fdf4; border-left: 4px solid #059669; padding: 16px; margin: 0 0 24px; border-radius: 4px;">
                  <p style="margin: 0 0 12px; font-size: 13px; font-weight: 600; color: #059669; text-transform: uppercase;">
                    Get Started in 3 Steps
                  </p>
                  <ol style="margin: 0; padding-left: 20px; color: #374151;">
                    <li style="margin: 0 0 8px; font-size: 14px; line-height: 1.5;">
                      <strong>Add your first customer</strong><br>
                      Go to Customers → Click "Add Customer" → Fill in customer details
                    </li>
                    <li style="margin: 0 0 8px; font-size: 14px; line-height: 1.5;">
                      <strong>Set up your products</strong><br>
                      Go to Products → Click "Add Product" → Define SKUs, pricing & tax info
                    </li>
                    <li style="margin: 0; font-size: 14px; line-height: 1.5;">
                      <strong>Create your first order</strong><br>
                      Go to Orders → Click "Create Order" → Select customer and products
                    </li>
                  </ol>
                </div>

                <!-- Key Features -->
                <p style="margin: 0 0 8px; font-size: 13px; font-weight: 600; color: #111827; text-transform: uppercase;">
                  You now have access to:
                </p>
                <ul style="margin: 0 0 24px; padding-left: 20px; color: #374151;">
                  <li style="margin: 0 0 6px; font-size: 14px;">📊 Dashboard with real-time insights</li>
                  <li style="margin: 0 0 6px; font-size: 14px;">👥 Customer relationship management</li>
                  <li style="margin: 0 0 6px; font-size: 14px;">📦 Inventory tracking & management</li>
                  <li style="margin: 0 0 6px; font-size: 14px;">📝 Automated invoicing & billing</li>
                  <li style="margin: 0 0 6px; font-size: 14px;">💰 Payment tracking & collection</li>
                </ul>

                <!-- CTA Button -->
                <table cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
                  <tr>
                    <td>
                      <a href="<%= @dashboard_link %>" style="display: inline-block; background: #059669; color: #ffffff; padding: 12px 32px; border-radius: 6px; font-weight: 600; font-size: 15px; text-decoration: none; text-align: center;">
                        Launch Dashboard →
                      </a>
                    </td>
                  </tr>
                </table>

                <!-- Resources -->
                <p style="margin: 0 0 8px; font-size: 13px; font-weight: 600; color: #111827; text-transform: uppercase;">
                  Need Help?
                </p>
                <ul style="margin: 0 0 24px; padding-left: 20px; color: #374151;">
                  <li style="margin: 0 0 6px; font-size: 14px;">
                    <a href="https://docs.orderlane.pro" style="color: #059669; text-decoration: none;">📖 Read our documentation</a>
                  </li>
                  <li style="margin: 0 0 6px; font-size: 14px;">
                    <a href="mailto:support@orderlane.pro" style="color: #059669; text-decoration: none;">✉️ Email our support team</a>
                  </li>
                  <li style="margin: 0 0 6px; font-size: 14px;">
                    <a href="https://orderlane.pro/support" style="color: #059669; text-decoration: none;">💬 Live chat (9 AM - 6 PM IST)</a>
                  </li>
                </ul>

                <!-- Closing -->
                <p style="margin: 0; font-size: 13px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                  We're excited to have <%= @organization.name %> on board. Let's grow your distribution business together! 🌱
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
