<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <!-- Header - Final Notice (Red/Urgent) -->
  <div style="background-color: #fef2f2; padding: 20px; border-bottom: 3px solid #991b1b; border-left: 5px solid #dc2626;">
    <h2 style="margin: 0; color: #7f1d1d;">
      🔴 FINAL NOTICE: Account At Risk
    </h2>
    <p style="margin: 5px 0 0 0; color: #991b1b; font-size: 14px;">
      Invoice <%= @invoice.invoice_number %> is <%= @days_overdue %> days overdue — Account suspension pending
    </p>
  </div>

  <!-- Main Content -->
  <div style="padding: 30px;">
    <p style="color: #7f1d1d; font-weight: 600;">Hi <%= @customer.name %>,</p>

    <p style="color: #dc2626; line-height: 1.6; margin: 20px 0;">
      <strong>This is your final notice.</strong> Invoice <%= @invoice.invoice_number %> remains unpaid for <%= @days_overdue %> days.
    </p>

    <p style="color: #555; line-height: 1.6;">
      Unless payment is received <strong>within the next 24 hours</strong>, your account will be immediately suspended. This will:
    </p>

    <ul style="color: #555; margin: 15px 0; padding-left: 20px;">
      <li style="margin-bottom: 8px;">Prevent new orders from being placed</li>
      <li style="margin-bottom: 8px;">Block access to your account</li>
      <li style="margin-bottom: 8px;">Damage your credit standing</li>
      <li style="margin-bottom: 8px;">Incur additional late fees and penalties</li>
    </ul>

    <!-- Invoice Details - Urgent Styling -->
    <div style="margin: 30px 0; border: 3px solid #dc2626; border-radius: 4px; padding: 20px; background-color: #fef2f2;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 14px;">
        <div>
          <p style="color: #7f1d1d; margin: 0 0 5px 0;">Invoice Number</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.invoice_number %></p>
        </div>
        <div>
          <p style="color: #7f1d1d; margin: 0 0 5px 0;">Days Overdue</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626; font-size: 18px;"><%= @days_overdue %> days</p>
        </div>
        <div>
          <p style="color: #7f1d1d; margin: 0 0 5px 0;">Amount Outstanding</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626; font-size: 18px;">₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></p>
        </div>
        <div>
          <p style="color: #7f1d1d; margin: 0 0 5px 0;">Original Due Date</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.due_date.strftime('%b %d, %Y') %></p>
        </div>
      </div>
    </div>

    <!-- CTA - Urgent -->
    <div style="margin: 30px 0; text-align: center;">
      <a href="<%= invoice_payment_url(@invoice) %>" style="display: inline-block; padding: 16px 50px; background-color: #dc2626; color: white; text-decoration: none; border-radius: 4px; font-weight: 700; font-size: 16px; border: 2px solid #991b1b;">
        PAY NOW TO PREVENT SUSPENSION
      </a>
    </div>

    <!-- Action Required Box -->
    <div style="margin: 30px 0; padding: 20px; background-color: #fef2f2; border-left: 4px solid #dc2626; border-radius: 4px;">
      <p style="color: #7f1d1d; font-weight: 600; margin: 0 0 10px 0;">⏰ ACTION REQUIRED WITHIN 24 HOURS</p>
      <p style="color: #555; margin: 0; line-height: 1.6;">
        Click the "Pay Now" button above to settle this invoice immediately. 
        Failing to do so will result in automatic account suspension without further notice.
      </p>
    </div>

    <hr style="border: none; border-top: 1px solid #fee2e2; margin: 30px 0;">

    <!-- Escalation Info -->
    <p style="color: #6b7280; font-size: 13px; line-height: 1.6;">
      <strong>This is Your Final Notice</strong><br>
      If you have already made this payment, please disregard this notice. Otherwise, contact us immediately 
      to discuss payment options or arrangements.<br><br>
      <strong>Support:</strong> <%= ENV['MAILER_FROM_ADDRESS'] %><br>
      <strong>Response Time:</strong> We respond within 1 hour
    </p>
  </div>

  <!-- Footer - Red -->
  <div style="background-color: #fef2f2; padding: 20px; text-align: center; border-top: 1px solid #fee2e2; font-size: 12px; color: #7f1d1d;">
    <p style="margin: 0; font-weight: 600;">
      Account Suspension Scheduled: <%= (Date.current + 1.day).strftime('%B %d, %Y') %>
    </p>
  </div>
</div>
