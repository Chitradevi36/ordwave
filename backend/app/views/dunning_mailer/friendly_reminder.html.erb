<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <!-- Header -->
  <div style="background-color: #f8f9fa; padding: 20px; border-bottom: 1px solid #dee2e6;">
    <h2 style="margin: 0; color: #1f2937;">
      Friendly Reminder: Payment Due
    </h2>
    <p style="margin: 5px 0 0 0; color: #6b7280; font-size: 14px;">
      Invoice <%= @invoice.invoice_number %>
    </p>
  </div>

  <!-- Main Content -->
  <div style="padding: 30px;">
    <p>Dear <%= @customer.name %>,</p>

    <p style="color: #555; line-height: 1.6;">
      We wanted to remind you that payment for invoice <strong><%= @invoice.invoice_number %></strong> 
      was due on <strong><%= @invoice.due_date.strftime('%B %d, %Y') %></strong>.
    </p>

    <p style="color: #555; line-height: 1.6;">
      If you've already sent the payment, please disregard this message. If you have any questions 
      or need an extension, please don't hesitate to contact us.
    </p>

    <!-- Invoice Details -->
    <div style="margin: 30px 0; border: 1px solid #dee2e6; border-radius: 4px; padding: 20px; background-color: #fafbfc;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 14px;">
        <div>
          <p style="color: #6b7280; margin: 0 0 5px 0;">Invoice Number</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.invoice_number %></p>
        </div>
        <div>
          <p style="color: #6b7280; margin: 0 0 5px 0;">Due Date</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.due_date.strftime('%b %d, %Y') %></p>
        </div>
        <div>
          <p style="color: #6b7280; margin: 0 0 5px 0;">Amount Due</p>
          <p style="margin: 0; font-weight: 600; color: #e74c3c;">₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></p>
        </div>
        <div>
          <p style="color: #6b7280; margin: 0 0 5px 0;">Days Overdue</p>
          <p style="margin: 0; font-weight: 600;"><%= @days_overdue %> days</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div style="margin: 30px 0; text-align: center;">
      <a href="<%= invoice_payment_url(@invoice) %>" style="display: inline-block; padding: 12px 30px; background-color: #3b82f6; color: white; text-decoration: none; border-radius: 4px; font-weight: 500;">
        Pay Now
      </a>
    </div>

    <hr style="border: none; border-top: 1px solid #dee2e6; margin: 30px 0;">

    <p style="color: #6b7280; font-size: 13px; line-height: 1.6;">
      <strong>Questions?</strong><br>
      Please reply to this email or contact us at <%= ENV['MAILER_FROM_ADDRESS'] %><br>
      Thank you for your prompt attention.
    </p>
  </div>

  <!-- Footer -->
  <div style="background-color: #f3f4f6; padding: 20px; text-align: center; border-top: 1px solid #dee2e6; font-size: 12px; color: #6b7280;">
    <p style="margin: 0;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
