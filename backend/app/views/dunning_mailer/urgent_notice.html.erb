<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <!-- Header - Urgent -->
  <div style="background-color: #fef3c7; padding: 20px; border-bottom: 3px solid #f59e0b; border-left: 5px solid #ef4444;">
    <h2 style="margin: 0; color: #d97706;">
      ⚠️ Urgent: Payment Overdue
    </h2>
    <p style="margin: 5px 0 0 0; color: #92400e; font-size: 14px;">
      Invoice <%= @invoice.invoice_number %> is now <%= @days_overdue %> days overdue
    </p>
  </div>

  <!-- Main Content -->
  <div style="padding: 30px;">
    <p style="color: #18181b;">Hi <%= @customer.name %>,</p>

    <p style="color: #555; line-height: 1.6;">
      <strong>Your payment for invoice <%= @invoice.invoice_number %> is now <%= @days_overdue %> days overdue.</strong>
    </p>

    <p style="color: #555; line-height: 1.6;">
      Payment was due on <strong><%= @invoice.due_date.strftime('%B %d, %Y') %></strong>. 
      Late payments may incur additional charges. Please process payment immediately to avoid further action.
    </p>

    <!-- Invoice Details -->
    <div style="margin: 30px 0; border: 2px solid #ef4444; border-radius: 4px; padding: 20px; background-color: #fef2f2;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 14px;">
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Invoice Number</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.invoice_number %></p>
        </div>
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Days Overdue</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626;"><%= @days_overdue %> days</p>
        </div>
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Amount Outstanding</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626;">₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></p>
        </div>
        <div>
          <p style="color: #991b1b; margin: 0 0 5px 0;">Original Due Date</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.due_date.strftime('%b %d, %Y') %></p>
        </div>
      </div>
    </div>

    <!-- CTA - Urgent -->
    <div style="margin: 30px 0; text-align: center;">
      <a href="<%= invoice_payment_url(@invoice) %>" style="display: inline-block; padding: 14px 40px; background-color: #dc2626; color: white; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 16px;">
        Pay Immediately
      </a>
    </div>

    <p style="color: #6b7280; font-size: 12px; margin-top: 20px; padding: 15px; background-color: #f3f4f6; border-radius: 4px;">
      <strong>⚠️ Important:</strong> Continued non-payment may result in account suspension and impact your credit terms.
    </p>

    <hr style="border: none; border-top: 1px solid #dee2e6; margin: 30px 0;">

    <p style="color: #6b7280; font-size: 13px; line-height: 1.6;">
      <strong>Need help?</strong><br>
      Contact us immediately: <%= ENV['MAILER_FROM_ADDRESS'] %><br>
      We're here to work with you on payment arrangements.
    </p>
  </div>

  <!-- Footer -->
  <div style="background-color: #f3f4f6; padding: 20px; text-align: center; border-top: 1px solid #dee2e6; font-size: 12px; color: #6b7280;">
    <p style="margin: 0;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
