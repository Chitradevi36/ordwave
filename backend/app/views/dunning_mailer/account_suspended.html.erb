<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <!-- Header - Suspended -->
  <div style="background-color: #1e293b; padding: 20px; border-bottom: 4px solid #dc2626;">
    <h2 style="margin: 0; color: #fff;">
      🔒 Your Account Has Been Suspended
    </h2>
    <p style="margin: 5px 0 0 0; color: #cbd5e1; font-size: 14px;">
      Action required to restore access
    </p>
  </div>

  <!-- Main Content -->
  <div style="padding: 30px;">
    <p style="color: #1e293b; font-weight: 600;">Hi <%= @customer.name %>,</p>

    <p style="color: #dc2626; line-height: 1.6; margin: 20px 0; font-size: 16px;">
      <strong>Your account has been suspended effective immediately</strong> due to unpaid invoice <%= @invoice.invoice_number %>.
    </p>

    <!-- What This Means -->
    <div style="margin: 30px 0; padding: 20px; background-color: #f8fafc; border-left: 4px solid #dc2626; border-radius: 4px;">
      <p style="color: #1e293b; font-weight: 600; margin: 0 0 15px 0;">Your Account Is Now Restricted:</p>
      <ul style="color: #475569; margin: 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Cannot place new orders</li>
        <li style="margin-bottom: 8px;">Cannot access your dashboard</li>
        <li style="margin-bottom: 8px;">Cannot manage deliveries</li>
        <li>All pending operations halted</li>
      </ul>
    </div>

    <!-- Invoice Details -->
    <div style="margin: 30px 0; border: 1px solid #e2e8f0; border-radius: 4px; padding: 20px; background-color: #f1f5f9;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 14px;">
        <div>
          <p style="color: #64748b; margin: 0 0 5px 0;">Invoice Number</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.invoice_number %></p>
        </div>
        <div>
          <p style="color: #64748b; margin: 0 0 5px 0;">Days Overdue</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626;"><%= @days_overdue %> days</p>
        </div>
        <div>
          <p style="color: #64748b; margin: 0 0 5px 0;">Outstanding Amount</p>
          <p style="margin: 0; font-weight: 600; color: #dc2626;">₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></p>
        </div>
        <div>
          <p style="color: #64748b; margin: 0 0 5px 0;">Due Date</p>
          <p style="margin: 0; font-weight: 600;"><%= @invoice.due_date.strftime('%b %d, %Y') %></p>
        </div>
      </div>
    </div>

    <!-- How to Restore -->
    <div style="margin: 30px 0;">
      <h3 style="color: #1e293b; margin: 0 0 15px 0; font-size: 16px;">How to Restore Your Account:</h3>
      <p style="color: #475569; margin: 0 0 10px 0;">
        Your account will be immediately restored upon receipt of payment for the outstanding invoice.
      </p>
    </div>

    <!-- CTA - Pay Now -->
    <div style="margin: 30px 0; text-align: center;">
      <a href="<%= invoice_payment_url(@invoice) %>" style="display: inline-block; padding: 14px 40px; background-color: #dc2626; color: white; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 16px;">
        Pay Now to Restore Account
      </a>
    </div>

    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 30px 0;">

    <!-- Support Info -->
    <p style="color: #475569; font-size: 13px; line-height: 1.6;">
      <strong>Questions or issues?</strong><br>
      Our support team is ready to help with payment arrangements or payment plan options.<br><br>
      <strong>Email:</strong> <%= ENV['MAILER_FROM_ADDRESS'] %><br>
      <strong>Response:</strong> We respond within 1 hour during business hours
    </p>

    <!-- Additional Notice -->
    <div style="margin: 30px 0; padding: 15px; background-color: #fef2f2; border-radius: 4px; border: 1px solid #fee2e2;">
      <p style="color: #7f1d1d; font-size: 12px; margin: 0;">
        <strong>Note:</strong> If payment has already been sent, please disregard this notice. 
        Your account will be automatically restored once payment is confirmed (may take 1-2 hours).
      </p>
    </div>
  </div>

  <!-- Footer -->
  <div style="background-color: #f8fafc; padding: 20px; text-align: center; border-top: 1px solid #e2e8f0; font-size: 12px; color: #64748b;">
    <p style="margin: 0;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
