<%# app/views/web/accounting/integrations/_provider_card.html.erb %>
<%# Locals: integration (AccountingIntegration), failed_count (Integer) %>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm p-5 flex flex-col gap-3">
  <%# Header row %>
  <div class="flex items-start justify-between">
    <div>
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">
        <%= provider_label(integration.provider) %>
      </p>
      <p class="text-xs text-gray-400 mt-0.5">
        <%= integration.sync_mode.to_s.humanize %>
      </p>
    </div>
    <%= render "web/accounting/integrations/status_badge", status: integration.status %>
  </div>

  <%# Stats row %>
  <div class="flex gap-4 text-xs text-gray-500 border-t border-gray-100 pt-3">
    <div>
      <span class="font-medium text-gray-700">Last sync:</span>
      <%= format_accounting_timestamp(integration.last_synced_at) %>
    </div>
    <% if failed_count.to_i > 0 %>
      <div>
        <span class="font-medium text-red-600"><%= failed_count %> failed</span>
      </div>
    <% end %>
  </div>

  <%# Last error (if any) %>
  <% if integration.last_error_message.present? %>
    <div class="text-xs text-red-600 bg-red-50 rounded px-2 py-1 truncate" title="<%= integration.last_error_message %>">
      ⚠ <%= truncate(integration.last_error_message, length: 80) %>
    </div>
  <% end %>

  <%# Actions %>
  <div class="flex gap-2 pt-1">
    <%= link_to "Configure",
          edit_web_accounting_integration_path(integration),
          class: "flex-1 text-center text-xs font-medium py-1.5 px-3 rounded border border-blue-600 text-blue-600 hover:bg-blue-50" %>
    <%= link_to "Sync Dashboard",
          web_accounting_sync_records_path(integration_id: integration.id),
          class: "flex-1 text-center text-xs font-medium py-1.5 px-3 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
