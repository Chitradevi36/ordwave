<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #EF4444; padding: 20px; border-radius: 8px 8px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 24px;">Delivery Update</h1>
  </div>

  <div style="background-color: #F9FAFB; padding: 30px; border-radius: 0 0 8px 8px;">
    <p style="color: #374151; font-size: 16px; line-height: 1.5; margin: 0 0 20px 0;">
      Hi <%= @customer.first_name %>,
    </p>

    <p style="color: #374151; font-size: 16px; line-height: 1.5; margin: 0 0 20px 0;">
      Unfortunately, we couldn't deliver your order <strong><%= @order.order_number %></strong> on the scheduled date. 
      <% if @order.total_amount.present? %>
        (Order amount: ₹<%= number_with_precision(@order.total_amount, precision: 2) %>)
      <% end %>
    </p>

    <div style="background-color: white; border-left: 4px solid #3B82F6; padding: 15px; margin: 20px 0; border-radius: 4px;">
      <p style="color: #1F2937; font-size: 16px; font-weight: 600; margin: 0 0 10px 0;">
        We've rescheduled your delivery for:
      </p>
      <p style="color: #3B82F6; font-size: 18px; font-weight: 700; margin: 0;">
        <%= @formatted_date %>
      </p>
    </div>

    <p style="color: #374151; font-size: 16px; line-height: 1.5; margin: 0 0 20px 0;">
      If this date doesn't work for you, please reply to this email or text us with "<strong>DECLINE</strong>" to arrange a different delivery time.
    </p>

    <div style="border-top: 1px solid #E5E7EB; padding-top: 20px; margin-top: 30px;">
      <p style="color: #6B7280; font-size: 14px; margin: 0;">
        <strong>Order Details:</strong>
      </p>
      <ul style="color: #6B7280; font-size: 14px; line-height: 1.8; margin: 10px 0 0 20px;">
        <li>Order Number: <strong><%= @order.order_number %></strong></li>
        <li>Customer: <strong><%= @customer.name %></strong></li>
        <li>Original Scheduled Date: <strong><%= @order.dispatched_at&.strftime('%B %d, %Y') || 'N/A' %></strong></li>
        <li>New Scheduled Date: <strong><%= @formatted_date %></strong></li>
      </ul>
    </div>

    <div style="background-color: #F3F4F6; padding: 15px; border-radius: 4px; margin-top: 20px;">
      <p style="color: #6B7280; font-size: 13px; margin: 0;">
        Need immediate assistance? Contact us at <%= @organization.phone || 'support' %> or reply to this email.
      </p>
    </div>

    <p style="color: #9CA3AF; font-size: 12px; margin-top: 30px; text-align: center;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
