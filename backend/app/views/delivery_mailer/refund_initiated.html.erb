<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background: #f5f5f5; padding: 20px; text-align: center;">
    <h1 style="color: #4CAF50; margin: 0; font-size: 20px;">Refund Processed</h1>
  </div>

  <div style="padding: 30px; background: white;">
    <p style="color: #666; margin: 0 0 20px 0;">
      Hi <strong><%= @customer.name %></strong>,
    </p>

    <p style="color: #666; margin: 0 0 20px 0;">
      Your refund for order <strong><%= @order.order_number %></strong> has been initiated.
    </p>

    <div style="background: #e8f5e9; border-left: 4px solid #4CAF50; padding: 20px; margin: 20px 0; border-radius: 4px;">
      <p style="margin: 0 0 10px 0; color: #2e7d32; font-size: 14px;">
        <strong>Refund Amount:</strong>
      </p>
      <p style="margin: 0; color: #2e7d32; font-size: 28px; font-weight: 600;">
        ₹<%= number_with_precision(@refund_amount, precision: 2) %>
      </p>
    </div>

    <h3 style="color: #333; margin: 25px 0 15px 0; font-size: 16px;">When will I get my refund?</h3>

    <ul style="color: #666; margin: 0 0 20px 0; padding-left: 20px;">
      <li style="margin-bottom: 10px;">
        <strong>Credit Card / Debit Card:</strong> 3-5 business days
      </li>
      <li style="margin-bottom: 10px;">
        <strong>Bank Transfer:</strong> 2-3 business days (NEFT/RTGS)
      </li>
      <li style="margin-bottom: 10px;">
        <strong>UPI / Wallet:</strong> Instant
      </li>
    </ul>

    <h3 style="color: #333; margin: 25px 0 15px 0; font-size: 16px;">Order Details</h3>

    <table style="width: 100%; color: #666; border-collapse: collapse;">
      <tr style="border-bottom: 1px solid #eee;">
        <td style="padding: 8px 0;">Order Number:</td>
        <td style="text-align: right; padding: 8px 0;"><strong><%= @order.order_number %></strong></td>
      </tr>
      <tr style="border-bottom: 1px solid #eee;">
        <td style="padding: 8px 0;">Order Date:</td>
        <td style="text-align: right; padding: 8px 0;"><%= @order.created_at.strftime('%b %d, %Y') %></td>
      </tr>
      <tr style="border-bottom: 1px solid #eee;">
        <td style="padding: 8px 0;">Refund Amount:</td>
        <td style="text-align: right; padding: 8px 0;"><strong style="color: #4CAF50;">₹<%= number_with_precision(@refund_amount, precision: 2) %></strong></td>
      </tr>
      <tr>
        <td style="padding: 8px 0;">Refund Status:</td>
        <td style="text-align: right; padding: 8px 0;"><span style="background: #4CAF50; color: white; padding: 2px 8px; border-radius: 3px; font-size: 12px;">Processing</span></td>
      </tr>
    </table>

    <p style="color: #999; margin: 30px 0 0 0; font-size: 12px;">
      If you have any questions or don't see the refund within the expected time, 
      please <a href="mailto:<%= @organization.support_email %>" style="color: #0066cc; text-decoration: none;">contact support</a>.
    </p>
  </div>

  <div style="padding: 20px; background: #f9f9f9; text-align: center; font-size: 11px; color: #999; border-top: 1px solid #eee;">
    <p style="margin: 0;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
