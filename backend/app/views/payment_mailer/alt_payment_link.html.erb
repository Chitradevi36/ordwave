<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; max-width: 500px; margin: 0 auto;">
  <div style="background: #f5f5f5; padding: 20px; text-align: center;">
    <h1 style="color: #333; margin: 0; font-size: 24px;">Payment Reminder</h1>
  </div>

  <div style="padding: 30px; background: white; border-bottom: 1px solid #eee;">
    <p style="color: #666; margin: 0 0 20px 0; font-size: 14px;">
      Hi <strong><%= @customer.name %></strong>,
    </p>

    <p style="color: #666; margin: 0 0 20px 0;">
      Your invoice <strong><%= @invoice.invoice_number %></strong> for 
      <strong style="color: #2c5f2d; font-size: 18px;">₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></strong>
      is due.
    </p>

    <p style="color: #666; margin: 0 0 20px 0; font-size: 13px;">
      Due Date: <strong><%= @invoice.due_date.strftime('%B %d, %Y') %></strong>
    </p>

    <div style="text-align: center; margin: 30px 0;">
      <a href="<%= @payment_link_url %>" 
         style="display: inline-block; padding: 12px 30px; background: #2c5f2d; color: white; text-decoration: none; border-radius: 4px; font-weight: 600;">
        Click Here to Pay
      </a>
    </div>

    <p style="color: #999; margin: 20px 0 0 0; font-size: 12px; text-align: center;">
      Or copy and paste this link in your browser:
    </p>
    <p style="color: #0066cc; margin: 5px 0 0 0; font-size: 12px; text-align: center; word-break: break-all;">
      <%= @payment_link_url %>
    </p>
  </div>

  <div style="padding: 20px; background: #f9f9f9; border-top: 1px solid #eee; font-size: 12px; color: #999;">
    <p style="margin: 0 0 10px 0;">
      <strong>Invoice Details:</strong>
    </p>
    <table style="width: 100%; color: #666;">
      <tr>
        <td style="padding: 3px 0;">Invoice Number:</td>
        <td style="text-align: right; padding: 3px 0;"><strong><%= @invoice.invoice_number %></strong></td>
      </tr>
      <tr>
        <td style="padding: 3px 0;">Invoice Date:</td>
        <td style="text-align: right; padding: 3px 0;"><%= @invoice.invoice_date.strftime('%b %d, %Y') %></td>
      </tr>
      <tr>
        <td style="padding: 3px 0;">Amount:</td>
        <td style="text-align: right; padding: 3px 0;"><strong>₹<%= number_with_precision(@invoice.total_amount, precision: 2) %></strong></td>
      </tr>
    </table>
  </div>

  <div style="padding: 20px; background: white; text-align: center; font-size: 11px; color: #999; border-top: 1px solid #eee;">
    <p style="margin: 0 0 10px 0;">
      Questions about this invoice? 
      <a href="mailto:<%= @organization.support_email %>" style="color: #0066cc; text-decoration: none;">
        Contact Support
      </a>
    </p>
    <p style="margin: 0;">
      © <%= Date.current.year %> <%= @organization.name %>. All rights reserved.
    </p>
  </div>
</div>
